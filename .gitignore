# Credentials. Never tracked (keep any .env / keys / credential files out of git).
.env*
*.key
.credentials*

# Raw agent transcripts and generated run workspaces stay local by default.
transcript.jsonl

# Local spec checker: measures the built figures and manuscript against the
# Nature figure/formatting guides. A working tool, not part of the paper.
paper_plot_script/check_nature_specs.py

# ICLR 2027 style files, kept locally as the formatting reference. Upstream
# template, not our work.
iclr-2027-style-files.zip
iclr2027/

# TUI harness: per-prompt agent workspaces (artifacts + transcripts)
tui_workspaces/
# TUI agent runs: <cwd>/Workspace/<md5(prompt)>/ artifacts (README §0)
Workspace/
# Optional retained screenshots/debug evidence.
visual-evidence/
tui/evidence/
tui/Workspace/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.ipynb_checkpoints/

# LaTeX build artifacts
*.aux
*.log
# ...except the small TUI e2e run logs (README §0).
!tui/evidence/*.log
*.out
*.toc
*.synctex.gz
*.fls
*.fdb_latexmk
*.bbl
*.blg

# OS
.DS_Store

